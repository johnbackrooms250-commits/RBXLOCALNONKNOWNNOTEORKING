bool name="Anchored">true</bool><bool name="CanCollide">true</bool></Properties></Item></Item><Item class="ServerScriptService" referent="RBX000327"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX000326"><Properties><bool name="Disabled">false</bool><string name="Name">GameServer</string><ProtectedString name="Source"><![CDATA[
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local RS = game:GetService("ReplicatedStorage")

local fireEvent = RS:WaitForChild("FireGun")
local buyEvent = RS:WaitForChild("BuyUpgrade")

local CONFIG = {
	SpawnInterval = 2.5,
	EnemyHealth = 60,
	EnemySpeed = 9,
	EnemyDamage = 12,
	AttackRange = 7,
	AttackCooldown = 1,
	KillReward = 100,
	PassiveIncome = 5,
	UpgradeBaseCost = 500,
	GunBaseDamage = 15,
	MaxRange = 400,
	FireCooldown = 0.1,
	RoadSpacing = 130,
	RoadCount = 4,
}

local enemyFolder = Instance.new("Folder")
enemyFolder.Name = "Enemies"
enemyFolder.Parent = workspace

local lastFire = {}

local function setupPlayer(plr)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	ls.Parent = plr
	for _, name in ipairs({"Dollars", "Kills", "Gems"}) do
		local v = Instance.new("IntValue")
		v.Name = name
		v.Value = 0
		v.Parent = ls
	end
	plr:SetAttribute("GunLevel", 1)
end

Players.PlayerAdded:Connect(setupPlayer)
for _, plr in ipairs(Players:GetPlayers()) do
	setupPlayer(plr)
end

local function makeEnemy()
	local model = Instance.new("Model")
	model.Name = "ToiletEnemy"

	local function add(name, size, offset, color, collide)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = CFrame.new(offset)
		p.Color = color
		p.Anchored = true
		p.CanCollide = collide
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = model
		return p
	end

	local body = add("Body", Vector3.new(4, 4, 4), Vector3.new(0, 0, 0), Color3.fromRGB(240, 240, 240), true)
	add("Lid", Vector3.new(4.4, 0.6, 4.4), Vector3.new(0, 2.3, 0), Color3.fromRGB(40, 40, 45), false)
	add("Head", Vector3.new(3, 3, 3), Vector3.new(0, 3.5, 0), Color3.fromRGB(255, 214, 180), true)
	add("EyeL", Vector3.new(0.6, 0.6, 0.1), Vector3.new(-0.8, 3.8, 1.55), Color3.fromRGB(20, 20, 20), false)
	add("EyeR", Vector3.new(0.6, 0.6, 0.1), Vector3.new(0.8, 3.8, 1.55), Color3.fromRGB(20, 20, 20), false)
	for _, sx in ipairs({-1, 1}) do
		for _, sz in ipairs({-1, 1}) do
			add("Leg", Vector3.new(0.5, 8, 0.5), Vector3.new(sx * 2.2, -4, sz * 2.2), Color3.fromRGB(30, 30, 30), false)
		end
	end

	model.PrimaryPart = body
	model:SetAttribute("Health", CONFIG.EnemyHealth)
	return model
end

local function randomRoadPosition()
	local k = math.random(-CONFIG.RoadCount, CONFIG.RoadCount)
	local t = math.random(-500, 500)
	local line = k * CONFIG.RoadSpacing
	if math.random() < 0.5 then
		return Vector3.new(t, 8, line)
	end
	return Vector3.new(line, 8, t)
end

local function damageEnemy(enemy, amount, attacker)
	local hp = enemy:GetAttribute("Health")
	if not hp or hp <= 0 then return end
	hp -= amount
	enemy:SetAttribute("Health", hp)
	if hp <= 0 then
		local ls = attacker:FindFirstChild("leaderstats")
		if ls then
			ls.Dollars.Value += CONFIG.KillReward
			ls.Kills.Value += 1
		end
		enemy:Destroy()
	end
end

fireEvent.OnServerEvent:Connect(function(plr, enemy)
	if typeof(enemy) ~= "Instance" or enemy.Parent ~= enemyFolder then return end
	local now = os.clock()
	if lastFire[plr] and now - lastFire[plr] < CONFIG.FireCooldown then return end
	lastFire[plr] = now

	local char = plr.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	if (enemy:GetPivot().Position - hrp.Position).Magnitude > CONFIG.MaxRange then return end

	local level = plr:GetAttribute("GunLevel") or 1
	damageEnemy(enemy, CONFIG.GunBaseDamage * level, plr)
end)

buyEvent.OnServerEvent:Connect(function(plr)
	local ls = plr:FindFirstChild("leaderstats")
	local level = plr:GetAttribute("GunLevel")
	if not ls or not level then return end
	local cost = CONFIG.UpgradeBaseCost * level
	if ls.Dollars.Value >= cost then
		ls.Dollars.Value -= cost
		plr:SetAttribute("GunLevel", level + 1)
	end
end)

-- Spawn enemies on the roads
task.spawn(function()
	while true do
		local enemy = makeEnemy()
		enemy:PivotTo(CFrame.new(randomRoadPosition()))
		enemy.Parent = enemyFolder
		task.wait(CONFIG.SpawnInterval)
	end
end)

-- Passive income
task.spawn(function()
	while true do
		task.wait(1)
		for _, plr in ipairs(Players:GetPlayers()) do
			local ls = plr:FindFirstChild("leaderstats")
			if ls then
				ls.Dollars.Value += CONFIG.PassiveIncome
			end
		end
	end
end)

-- Enemy AI: walk toward nearest player, attack when close
RunService.Heartbeat:Connect(function(dt)
	for _, enemy in ipairs(enemyFolder:GetChildren()) do
		if enemy.Parent ~= enemyFolder then continue end
		local pos = enemy:GetPivot().Position
		local here = Vector3.new(pos.X, 0, pos.Z)

		local best, bestDist = nil, math.huge
		for _, plr in ipairs(Players:GetPlayers()) do
			local char = plr.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if hrp and hum and hum.Health > 0 then
				local d = (hrp.Position - pos).Magnitude
				if d < bestDist then
					best, bestDist = char, d
				end
			end
		end

		if best then
			local tp = best.HumanoidRootPart.Position
			local target = Vector3.new(tp.X, 0, tp.Z)
			local dir = target - here
			local dist = dir.Magnitude
			if dist > CONFIG.AttackRange then
				local newPos = here + dir.Unit * math.min(CONFIG.EnemySpeed * dt, dist)
				enemy:PivotTo(CFrame.lookAt(Vector3.new(newPos.X, 8, newPos.Z), Vector3.new(target.X, 8, target.Z)))
			else
				local now = os.clock()
				local last = enemy:GetAttribute("LastAttack") or 0
				if now - last >= CONFIG.AttackCooldown then
					enemy:SetAttribute("LastAttack", now)
					best.Humanoid:TakeDamage(CONFIG.EnemyDamage)
				end
			end
		end
	end
end)

Players.PlayerRemoving:Connect(function(plr)
	lastFire[plr] = nil
end)
]]></ProtectedString></Properties></Item></Item><Item class="ReplicatedStorage" referent="RBX000330"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="RemoteEvent" referent="RBX000328"><Properties><string name="Name">FireGun</string></Properties></Item><Item class="RemoteEvent" referent="RBX000329"><Properties><string name="Name">BuyUpgrade</string></Properties></Item></Item><Item class="StarterPlayer" referent="RBX000334"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX000333"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX000331"><Properties><bool name="Disabled">false</bool><string name="Name">GunClient</string><ProtectedString name="Source"><![CDATA[
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local RS = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local fireEvent = RS:WaitForChild("FireGun")

local FIRE_RATE = 0.12
local lastShot = 0
local holding = false

UIS.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		holding = true
	end
end)

UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		holding = false
	end
end)

RunService.RenderStepped:Connect(function()
	if not holding then return end
	local now = os.clock()
	if now - lastShot < FIRE_RATE then return end
	lastShot = now

	local enemies = workspace:FindFirstChild("Enemies")
	if not enemies then return end

	local mouse = UIS:GetMouseLocation()
	local ray = camera:ViewportPointToRay(mouse.X, mouse.Y)

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character }

	local result = workspace:Raycast(ray.Origin, ray.Direction * 600, params)
	if result then
		local model = result.Instance:FindFirstAncestorOfClass("Model")
		if model and model.Parent == enemies then
			fireEvent:FireServer(model)
		end
	end
end)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX000332"><Properties><bool name="Disabled">false</bool><string name="Name">HUD</string><ProtectedString name="Source"><![CDATA[
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local buyEvent = RS:WaitForChild("BuyUpgrade")
local leaderstats = player:WaitForChild("leaderstats")
local dollars = leaderstats:WaitForChild("Dollars")

local gui = Instance.new("ScreenGui")
gui.Name = "GameHUD"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local moneyLabel = Instance.new("TextLabel")
moneyLabel.Size = UDim2.new(0, 320, 0, 40)
moneyLabel.Position = UDim2.new(0.5, -160, 1, -60)
moneyLabel.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
moneyLabel.BackgroundTransparency = 0.3
moneyLabel.TextColor3 = Color3.fromRGB(120, 255, 120)
moneyLabel.Font = Enum.Font.GothamBold
moneyLabel.TextScaled = true
moneyLabel.Parent = gui

local shopButton = Instance.new("TextButton")
shopButton.Size = UDim2.new(0, 120, 0, 50)
shopButton.Position = UDim2.new(0, 20, 1, -70)
shopButton.BackgroundColor3 = Color3.fromRGB(230, 170, 30)
shopButton.TextColor3 = Color3.new(1, 1, 1)
shopButton.Font = Enum.Font.GothamBold
shopButton.TextScaled = true
shopButton.Text = "SHOP"
shopButton.Parent = gui

local shop = Instance.new("Frame")
shop.Size = UDim2.new(0, 320, 0, 200)
shop.Position = UDim2.new(0.5, -160, 0.5, -100)
shop.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
shop.Visible = false
shop.Parent = gui

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 40)
title.BackgroundTransparency = 1
title.TextColor3 = Color3.new(1, 1, 1)
title.Font = Enum.Font.GothamBold
title.TextScaled = true
title.Text = "Character Shop"
title.Parent = shop

local upgradeButton = Instance.new("TextButton")
upgradeButton.Size = UDim2.new(0.9, 0, 0, 60)
upgradeButton.Position = UDim2.new(0.05, 0, 0, 60)
upgradeButton.BackgroundColor3 = Color3.fromRGB(60, 140, 60)
upgradeButton.TextColor3 = Color3.new(1, 1, 1)
upgradeButton.Font = Enum.Font.GothamBold
upgradeButton.TextScaled = true
upgradeButton.Parent = shop

local closeButton = Instance.new("TextButton")
closeButton.Size = UDim2.new(0.9, 0, 0, 40)
closeButton.Position = UDim2.new(0.05, 0, 0, 140)
closeButton.BackgroundColor3 = Color3.fromRGB(150, 40, 40)
closeButton.TextColor3 = Color3.new(1, 1, 1)
closeButton.Font = Enum.Font.GothamBold
closeButton.TextScaled = true
closeButton.Text = "Close"
closeButton.Parent = shop

local function refresh()
	local level = player:GetAttribute("GunLevel") or 1
	local cost = 500 * level
	moneyLabel.Text = "Dollars: $" .. dollars.Value .. "   |   Gun Lv " .. level
	upgradeButton.Text = "Gun Lv " .. level .. " -> " .. (level + 1) .. "  ($" .. cost .. ")"
end

shopButton.MouseButton1Click:Connect(function()
	shop.Visible = not shop.Visible
end)

closeButton.MouseButton1Click:Connect(function()
	shop.Visible = false
end)

upgradeButton.MouseButton1Click:Connect(function()
	buyEvent:FireServer()
end)

dollars.Changed:Connect(refresh)
player:GetAttributeChangedSignal("GunLevel"):Connect(refresh)
refresh()
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterGui" referent="RBX000335"><Properties><string name="Name">StarterGui</string></Properties></Item></roblox>